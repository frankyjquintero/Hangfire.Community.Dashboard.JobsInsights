<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>

		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>artifacts</PackageOutputPath>

		<PackageId>Hangfire.Community.Dashboard.JobsInsights</PackageId>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/frankyjquintero/Hangfire.Community.Dashboard.JobsInsights</RepositoryUrl>
		<Description>
			Adds an operational observability layer to the Hangfire Dashboard.
			Monitor your background jobs with a live summary grouped by job type,
			showing recent execution statuses (success/failure), average durations,
			and a detailed history view with client-side pagination and search.
			Includes an interactive chart panel for duration trends and throughput
			(executions &amp; success rate) over multiple time ranges, configurable
			alerts, and built-in data retention management.
			Designed to work within the native Hangfire ecosystem without external
			dependencies.
		</Description>
		
		<PackageTags>hangfire dashboard jobs insights monitoring observability metrics heatmap recurring-jobs background-jobs</PackageTags>


		<Authors>FrankyJquintero</Authors>
		<Product>Hangfire.Community.Dashboard.JobsInsights</Product>
		<Version>1.0.1</Version>
		<AssemblyVersion>1.0.1</AssemblyVersion>
		<LangVersion>7.3</LangVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
		<IncludeContentInPack>true</IncludeContentInPack>
		<RazorViewsCodeGenDirectory>$(MSBuildProjectDirectory)\</RazorViewsCodeGenDirectory>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <NoWarn>1701;1702;CS2002;2002</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <NoWarn>1701;1702;CS2002;2002</NoWarn>
	</PropertyGroup>

	<!-- README -->
	<ItemGroup>
		<Content Include="..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<!-- Razor -->
	<ItemGroup>
		<!-- Vista principal (JobsInsightsPage) -->
		<None Update="Pages\JobsInsightsPage.cshtml">
			<Generator>RazorGenerator</Generator>
			<LastGenOutput>JobsInsightsPage.cshtml.cs</LastGenOutput>
		</None>

		<!-- Vistas parciales -->
		<None Update="Pages\_TopBar.cshtml">
			<Generator>RazorGenerator</Generator>
			<LastGenOutput>_TopBar.cshtml.cs</LastGenOutput>
		</None>
		<None Update="Pages\_SummaryView.cshtml">
			<Generator>RazorGenerator</Generator>
			<LastGenOutput>_SummaryView.cshtml.cs</LastGenOutput>
		</None>
		<None Update="Pages\_DurationChart.cshtml">
			<Generator>RazorGenerator</Generator>
			<LastGenOutput>_DurationChart.cshtml.cs</LastGenOutput>
		</None>
		<None Update="Pages\_DetailView.cshtml">
			<Generator>RazorGenerator</Generator>
			<LastGenOutput>_DetailView.cshtml.cs</LastGenOutput>
		</None>

		<!-- Agrega más archivos aquí siguiendo el mismo patrón -->
	</ItemGroup>


	<!-- Dependencias -->
	<ItemGroup>
		<PackageReference Include="HangFire.Core" Version="1.8.0" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
		<PackageReference Include="RazorGenerator.MsBuild" Version="2.5.0" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Pages\Js\" />
	  <Folder Include="Pages\Css\" />

		<!-- Archivos js modulares -->
		<EmbeddedResource Include="Pages\Js\jobsinsights.util.js" />
		<EmbeddedResource Include="Pages\Js\jobsinsights.chart.js" />
		<EmbeddedResource Include="Pages\Js\jobsinsights.summary.js" />
		<EmbeddedResource Include="Pages\Js\jobsinsights.modal.js" />
		<EmbeddedResource Include="Pages\Js\jobsinsights.init.js" />

		<!-- Archivos css modulares -->
		<EmbeddedResource Include="Pages\Css\jobsinsights.css" />
	</ItemGroup>
	
	

</Project>