<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>

		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>artifacts</PackageOutputPath>

		<PackageId>Hangfire.Community.Dashboard.JobsInsights</PackageId>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/frankyjquintero/Hangfire.Community.Dashboard.JobsInsights</RepositoryUrl>
		<Description>
			Adds an operational observability layer to the Hangfire Dashboard.
			Monitor your background jobs with a live summary grouped by job type,
			showing recent execution statuses (success/failure), average durations,
			and a detailed history view with client-side pagination and search.
			Includes an interactive chart panel for duration trends and throughput
			(executions &amp; success rate) over multiple time ranges, configurable
			alerts, and built-in data retention management.
			Designed to work within the native Hangfire ecosystem without external
			dependencies.
		</Description>
		
		<PackageTags>hangfire dashboard jobs insights monitoring observability metrics heatmap recurring-jobs background-jobs</PackageTags>


		<Authors>FrankyJquintero</Authors>
		<Product>Hangfire.Community.Dashboard.JobsInsights</Product>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<LangVersion>7.3</LangVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
		<IncludeContentInPack>true</IncludeContentInPack>
		<RazorViewsCodeGenDirectory>$(MSBuildProjectDirectory)\</RazorViewsCodeGenDirectory>
	</PropertyGroup>

	<!-- README -->
	<ItemGroup>
		<Content Include="..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<!-- Razor -->
	<ItemGroup>
		<Compile Update="Pages\JobStatus.cshtml.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>JobStatus.cshtml</DependentUpon>
		</Compile>
		<!-- Agrega más archivos aquí siguiendo el mismo patrón -->
	</ItemGroup>
	<ItemGroup>
		<None Update="Pages\JobStatus.cshtml">
			<Generator>RazorGenerator</Generator>
			<LastGenOutput>JobStatus.cshtml.cs</LastGenOutput>
		</None>
		<!-- Agrega más archivos aquí siguiendo el mismo patrón -->
	</ItemGroup>


	<!-- Dependencias -->
	<ItemGroup>
		<PackageReference Include="HangFire.Core" Version="1.7.28" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
		<PackageReference Include="RazorGenerator.MsBuild" Version="2.5.0" PrivateAssets="all" />
	</ItemGroup>

</Project>