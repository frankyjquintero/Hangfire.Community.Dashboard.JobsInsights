<Project ToolsVersion="14.0" DefaultTargets="PrecompileRazorFiles"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Import dinámico (portable, CI-friendly) -->
  <Import Project="$(PkgRazorGenerator_MsBuild)\build\RazorGenerator.MsBuild.targets"
          Condition="Exists('$(PkgRazorGenerator_MsBuild)\build\RazorGenerator.MsBuild.targets')" />

  <PropertyGroup>
    <RootNamespace>Hangfire.Community.Dashboard.JobsInsights</RootNamespace>
    <GeneratePrettyNames>true</GeneratePrettyNames>

    <!-- Mantiene los .generated.cs junto a los .cshtml -->
    <RazorViewsCodeGenDirectory>$(MSBuildThisFileDirectory)</RazorViewsCodeGenDirectory>

    <!-- Fuerza recompilación siempre -->
    <RazorCodeGenForceRegenerate>true</RazorCodeGenForceRegenerate>
  </PropertyGroup>

  <!-- Archivos Razor a compilar -->
  <ItemGroup>
    <RazorFiles Include="$(MSBuildThisFileDirectory)Pages\*.cshtml" />
  </ItemGroup>

  <!-- Evita caching interno de MSBuild -->
  <Target Name="ForceRegenerate" BeforeTargets="PrecompileRazorFiles">
    <Message Text="Forcing Razor regeneration..." Importance="high" />
    <ItemGroup>
      <RazorFilesForce Include="@(RazorFiles)" />
    </ItemGroup>
  </Target>

</Project>