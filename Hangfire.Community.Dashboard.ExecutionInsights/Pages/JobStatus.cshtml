@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True Namespace: Hangfire.Community.Dashboard.ExecutionInsights.Pages *@
@using Hangfire.Dashboard
@using Hangfire.Community.Dashboard.ExecutionInsights
@using Hangfire.Community.Dashboard.ExecutionInsights.Pages
@using Hangfire.Dashboard.Pages
@inherits Hangfire.Dashboard.RazorPage
@{
    Layout = new LayoutPage(JobStatus.Title);
    var summaryApiUrl = $"{Url.To(ExecutionInsightsExtension.RouteBase)}/api/jobtype-summary";
    var detailApiUrl = $"{Url.To(ExecutionInsightsExtension.RouteBase)}/api/jobtype-detail";
    var version = typeof(ExecutionInsightsExtension).Assembly.GetName().Version;
    var versionString = $"v{version.Major}.{version.Minor}.{version.Build}";
}

<style>
    /* ===== Puntos de colores para el resumen ===== */
    .state-dot {
        display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 3px;
        background-color: #ccc;
        cursor: pointer;
    }
    .state-dot.succeeded { background-color: #5cb85c; }
    .state-dot.failed    { background-color: #d9534f; }
    .state-dot.processing { background-color: #f0ad4e; }

    /* ===== Cabeceras ordenables ===== */
    th.sortable { cursor: pointer; user-select: none; }
    th.sortable:hover { background-color: #e0e0e0; }
    th.sortable::after {
        content: " ⇅";
        opacity: 0.3;
    }
    th.sortable.asc::after {
        content: " ↑";
        opacity: 1;
    }
    th.sortable.desc::after {
        content: " ↓";
        opacity: 1;
    }

    /* ===== Animación de fade-in ===== */
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .fade-in { animation: fadeIn 0.3s; }
</style>

<div id="dot-tooltip" style="display:none; position:fixed; background:#333; color:#fff; padding:8px 12px; border-radius:4px; font-size:12px; z-index:9999; pointer-events:none;"></div>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h3>
                @JobStatus.Title
                <small class="text-muted">@versionString</small>
                <button class="btn btn-default btn-sm pull-right" id="refresh-btn">
                    <span class="glyphicon glyphicon-refresh"></span> Refresh
                </button>
                <button class="btn btn-default btn-sm pull-right" id="toggle-auto-refresh">
                    <span class="glyphicon glyphicon-pause"></span> Pause
                </button>                 
            </h3>
            <hr />
        </div>
    </div>
    <!-- VISTA RESUMEN -->
    <div id="summary-view">
         <div class="row" id="cleanup-section">
            <div class="col-md-3">
                <input type="text" class="form-control input-sm" id="summary-jobtype-filter" placeholder="Filter by job type...">
            </div>
            <!-- Filtro de estado -->
            <div class="col-md-3">
                <div class="input-group">
                    <select class="form-control input-sm" id="summary-state-filter">
                        <option value="">All States</option>
                        <option value="Succeeded">Success</option>
                        <option value="Failed">Failed</option>
                    </select>
                    <span class="input-group-btn">
                        <button class="btn btn-primary btn-sm" id="summary-apply">Apply</button>
                    </span>
                </div>
            </div>

            <div class="col-md-2">
                <div class="input-group">
                    <span class="input-group-addon">Retention days</span>
                    <input type="number" class="form-control input-sm" id="retention-days" value="30" min="1" style="width:90px" maxlength="2"/>
                    <span class="input-group-btn">
                        <button class="btn btn-danger btn-sm" id="cleanup-btn">Delete older</button>
                    </span>
                </div>
                <span id="cleanup-msg" class="text-muted small"></span>
            </div>
        </div>
        <br/>
         <!-- Estadísticas rápidas -->
        <div class="row" style="margin-bottom:15px;">
            <div class="col-md-3">
                <span class="label label-default">Types: <strong id="stat-types">-</strong></span>
            </div>
            <div class="col-md-3">
                <span class="label label-info">Total Executions: <strong id="stat-total">-</strong></span>
            </div>
            <div class="col-md-3">
                <span class="label label-success">Success Rate: <strong id="stat-rate">-</strong></span>
            </div>
            <div class="col-md-3">
                <span class="label label-default">Updated: <strong id="stat-updated">-</strong></span>
            </div>
        </div>

        <div class="row" style="margin-top:15px;">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="summary-table">
                        <thead>
                            <tr>
                                <th>Job Type</th>
                                <th>Last 15 Executions</th>
                                <th>Success</th>
                                <th>Failed</th>
                                <th>Last Execution</th>
                                <th>Avg Duration</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="summary-body">
                            <tr>
                                <td colspan="6" class="text-center text-muted">Loading...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- VISTA DETALLE (Full History) -->
    <div id="detail-view" style="display:none;">
        <div class="row">
            <div class="col-md-12">
                <button class="btn btn-link btn-sm" id="back-to-summary">
                    <span class="glyphicon glyphicon-chevron-left"></span> Back to Summary
                </button>
                <h4>Full History: <span id="detail-jobtype-label"></span></h4>
            </div>
        </div>
        <!-- Filtros del detalle -->
        <div class="row">
            <div class="col-md-3">
                <select class="form-control input-sm" id="detail-state-filter">
                    <option value="">All States</option>
                    <option value="Succeeded">Success</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control input-sm" id="detail-search" placeholder="Search by ID, error, queue...">
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm" id="detail-apply">Apply</button>
                <button class="btn btn-default btn-sm" id="detail-clear">Clear</button>
                <button class="btn btn-default btn-sm" id="detail-reload"><span class="glyphicon glyphicon-refresh"></span></button>
            </div>
        </div>
        <div class="row" style="margin-top:15px;">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table table-hover" id="detail-table">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="jobId">Job ID</th>
                                <th class="sortable" data-sort="queue">Queue</th>
                                <th class="sortable" data-sort="lastState">Last State</th>
                                <th class="sortable" data-sort="lastTimestamp">Last Execution</th>
                                <th>Error</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="detail-body">
                            <tr>
                                <td colspan="6" class="text-center text-muted">Loading...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div id="detail-pagination" class="text-right"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        var summaryApiUrl = '@summaryApiUrl';
        var detailApiUrl = '@detailApiUrl';
        var adminApiBase = '@Url.To(ExecutionInsightsExtension.RouteBase) + "/api/admin"';
        var allDetailJobs = [];
        var filteredJobs = [];
        var currentJobType = null;
        var currentPage = 1;
        var pageSize = 20;
        var autoRefresh = true;
        var refreshTimer = null;
        var currentSort = { field: 'lastTimestamp', direction: 'desc' };
        var tooltipDiv = document.getElementById('dot-tooltip');

        // Helpers nativos
        function $(id) { return document.getElementById(id); }
        function on(selector, event, handler) {
            var els = document.querySelectorAll(selector);
            for (var i = 0; i < els.length; i++) {
                els[i].addEventListener(event, handler);
            }
        }

        function init() {
            loadSummary();

            $('refresh-btn').addEventListener('click', function() {
                if ($('summary-view').style.display !== 'none') loadSummary();
                else if (currentJobType) loadDetail(currentJobType);
            });
            $('summary-apply').addEventListener('click', loadSummary);
            $('detail-apply').addEventListener('click', function() {
                if (currentJobType) loadDetail(currentJobType);
            });
            $('detail-clear').addEventListener('click', function() {
                $('detail-search').value = '';
                $('detail-state-filter').value = '';
                loadDetail(currentJobType);
            });
            $('detail-reload').addEventListener('click', function() {
                if (currentJobType) loadDetail(currentJobType);
            });
            $('back-to-summary').addEventListener('click', showSummary);

            // Auto-refresh
            refreshTimer = setInterval(function() {
                if (autoRefresh && $('summary-view').style.display !== 'none') {
                    loadSummary();
                }
            }, 15000);

            $('toggle-auto-refresh').addEventListener('click', function() {
                autoRefresh = !autoRefresh;
                var icon = this.querySelector('.glyphicon');
                if (autoRefresh) {
                    icon.className = 'glyphicon glyphicon-pause';
                    this.innerHTML = '<span class="glyphicon glyphicon-pause"></span> Pause';
                } else {
                    icon.className = 'glyphicon glyphicon-play';
                    this.innerHTML = '<span class="glyphicon glyphicon-play"></span> Resume';
                }
            });

            // Ordenación de columnas en la tabla de detalle
            on('#detail-table th.sortable', 'click', function() {
                var field = this.getAttribute('data-sort');
                if (currentSort.field === field) {
                    currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                } else {
                    currentSort.field = field;
                    currentSort.direction = 'asc';
                }
                sortAndFilter();
                renderDetailPage();
                updateSortIndicators();
            });

            // Botón de limpieza
            $('cleanup-btn').addEventListener('click', function() {
                var days = parseInt($('retention-days').value);
                if (!confirm('Delete all job results older than ' + days + ' days?')) return;
    
                $('cleanup-msg').textContent = 'Cleaning...';
                fetch(adminApiBase + '/cleanup?days=' + encodeURIComponent(days), { method: 'POST' })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        $('cleanup-msg').innerHTML = '<span class="label label-success">Removed ' + data.removed + ' jobs.</span>';
                        // Opcional: refrescar estadísticas y resumen tras limpieza
                        loadSummary();
                    })
                    .catch(function(err) {
                        $('cleanup-msg').innerHTML = '<span class="label label-danger">Error: ' + err.message + '</span>';
                    });
            });
        }

        function showSummary() {
            $('summary-view').style.display = 'block';
            $('detail-view').style.display = 'none';
        }

        function loadSummary() {
            var state = $('summary-state-filter').value;
            var jobTypeFilter = ($('summary-jobtype-filter').value || '').toLowerCase();
            var url = summaryApiUrl + (state ? '?state=' + encodeURIComponent(state) : '');

            $('summary-body').innerHTML = '<tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>';
            fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    var summaries = data.summaries || [];
                    // Filtrar por tipo de job si hay texto
                    if (jobTypeFilter) {
                        summaries = summaries.filter(function(s) {
                            return s.jobType.toLowerCase().indexOf(jobTypeFilter) !== -1;
                        });
                    }
                    renderSummary(summaries);
                })
                .catch(function(err) {
                    $('summary-body').innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error: ' + err.message + '</td></tr>';
                });
        }

        function renderSummary(summaries) {
            var tbody = $('summary-body');
            if (!summaries.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No job types found.</td></tr>';
                updateStats(0, 0, 0);
                return;
            }

            var html = '';
            var totalSuccess = 0, totalFailed = 0;
            summaries.forEach(function(s) {
                var dots = '';
                if (s.recentExecutions) {
                    s.recentExecutions.forEach(function(exec) {
                        var cls = exec.state ? exec.state.toLowerCase() : '';
                        var title = exec.state + ' at ' + new Date(exec.timestamp).toLocaleTimeString();
                        dots += '<span class="state-dot ' + cls + '" data-state="' + exec.state + '" data-time="' + new Date(exec.timestamp).toLocaleString() + '" data-jobid="' + (exec.jobId || '') + '" data-duration="' + (exec.duration != null ? exec.duration.toFixed(1)+'s' : '') + '"></span>';
                    });
                }
                var lastExec = s.lastExecution ? relativeTime(new Date(s.lastExecution)) : 'N/A';
                var avgDuration = s.avgDuration ? (s.avgDuration.toFixed(1) + 's') : 'N/A';

                html += '<tr>';
                html += '<td>' + escapeHtml(s.jobType) + '</td>';
                html += '<td>' + dots + '</td>';
                html += '<td><span class="badge">' + s.successCount + '</span></td>';
                html += '<td><span class="badge">' + s.failedCount + '</span></td>';
                html += '<td>' + lastExec + '</td>';
                html += '<td>' + avgDuration + '</td>';
                html += '<td><button class="btn btn-xs btn-default view-history" data-jobtype="' + escapeHtml(s.jobType) + '">View Full History</button></td>';
                html += '</tr>';
                totalSuccess += s.successCount;
                totalFailed += s.failedCount;
            });
            tbody.innerHTML = html;

            updateStats(summaries.length, totalSuccess, totalFailed);

            // Tooltip en los puntos
            var dots = document.querySelectorAll('#summary-body .state-dot');
            for (var i = 0; i < dots.length; i++) {
                (function(dot) {
                    dot.addEventListener('mouseenter', function(e) {
                        var el = e.target;
                        var state = el.getAttribute('data-state');
                        var time = el.getAttribute('data-time');
                        var jobId = el.getAttribute('data-jobid');
                        var duration = el.getAttribute('data-duration');
                        var html = '<strong>' + state + '</strong><br>' + time;
                        if (duration) html += '<br>Duration: ' + duration;
                        if (jobId) html += '<br>Job: <a href="' + jobDetailUrl(jobId) + '" target="_blank">#' + jobId.substring(0,8) + '</a>';
                        tooltipDiv.innerHTML = html;
                        tooltipDiv.style.display = 'block';
                        var rect = el.getBoundingClientRect();
                        var left = rect.left + window.scrollX + rect.width/2 - tooltipDiv.offsetWidth/2;
                        var top = rect.top + window.scrollY - tooltipDiv.offsetHeight - 8;
                        tooltipDiv.style.left = left + 'px';
                        tooltipDiv.style.top = top + 'px';
                    });
                    dot.addEventListener('mouseleave', function() {
                        tooltipDiv.style.display = 'none';
                    });
                })(dots[i]);
            }

            // Click en puntos de colores para ir al detalle filtrado
            on('.state-dot', 'click', function() {
                var state = this.getAttribute('data-state');
                var jobType = this.closest('tr').querySelector('.view-history').getAttribute('data-jobtype');
                showDetail(jobType);
                setTimeout(function() {
                    $('detail-state-filter').value = state;
                    loadDetail(jobType);
                }, 200);
            });

            // Evento para los botones "View Full History"
            on('.view-history', 'click', function() {
                var jobType = this.getAttribute('data-jobtype');
                showDetail(jobType);
            });
        }

        function updateStats(types, success, failed) {
            var total = success + failed;
            $('stat-types').textContent = types;
            $('stat-total').textContent = total;
            var rate = total ? (success / total * 100).toFixed(1) + '%' : '-';
            $('stat-rate').textContent = rate;
            $('stat-updated').textContent = new Date().toLocaleTimeString();
        }

        function showDetail(jobType) {
            currentJobType = jobType;
            currentPage = 1;
            // Reiniciar ordenación y filtro
            currentSort = { field: 'lastTimestamp', direction: 'desc' };
            $('detail-search').value = '';
            $('detail-state-filter').value = '';
            $('summary-view').style.display = 'none';
            $('detail-view').style.display = 'block';
            $('detail-jobtype-label').textContent = jobType;
            loadDetail(jobType);
        }

        function loadDetail(jobType) {
            var state = $('detail-state-filter').value;
            var url = detailApiUrl + '?jobType=' + encodeURIComponent(jobType);
            if (state) url += '&state=' + encodeURIComponent(state);

            $('detail-body').innerHTML = '<tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>';
            $('detail-pagination').innerHTML = '';

            fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    allDetailJobs = data.jobs || [];
                    sortAndFilter();
                    renderDetailPage();
                })
                .catch(function(err) {
                    $('detail-body').innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error: ' + err.message + '</td></tr>';
                });
        }

        function sortAndFilter() {
            var search = ($('detail-search').value || '').toLowerCase();
            // Filtrar primero
            filteredJobs = allDetailJobs.filter(function(j) {
                if (!search) return true;
                return (j.jobId && j.jobId.toLowerCase().indexOf(search) !== -1) ||
                       (j.errorMessage && j.errorMessage.toLowerCase().indexOf(search) !== -1) ||
                       (j.queue && j.queue.toLowerCase().indexOf(search) !== -1);
            });

            // Ordenar
            var field = currentSort.field;
            var dir = currentSort.direction;
            filteredJobs.sort(function(a, b) {
                var valA = a[field] || '';
                var valB = b[field] || '';
                if (field === 'lastTimestamp') {
                    valA = new Date(a.lastTimestamp).getTime();
                    valB = new Date(b.lastTimestamp).getTime();
                } else {
                    valA = valA.toString().toLowerCase();
                    valB = valB.toString().toLowerCase();
                }
                if (valA < valB) return dir === 'asc' ? -1 : 1;
                if (valA > valB) return dir === 'asc' ? 1 : -1;
                return 0;
            });
        }

        function renderDetailPage() {
            var total = filteredJobs.length;
            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;
            var pageJobs = filteredJobs.slice(start, end);
            renderDetail(pageJobs, total);
        }

        function renderDetail(jobs, total) {
            var tbody = $('detail-body');
            var paginationDiv = $('detail-pagination');
            if (!jobs.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No jobs found.</td></tr>';
                paginationDiv.innerHTML = '';
                return;
            }

            var html = '';
            jobs.forEach(function(j) {
                var shortId = j.jobId ? j.jobId.substring(0, 8) : '';
                var stateClass = j.lastState ? j.lastState.toLowerCase() : '';
                var badgeClass = stateClass === 'succeeded' ? 'label label-success' :
                                 stateClass === 'failed' ? 'label label-danger' : 'label label-default';
                var ts = j.lastTimestamp ? relativeTime(new Date(j.lastTimestamp)) : '';
                var errorHtml = '';
                if (j.errorMessage) {
                    if (j.errorMessage.length > 80) {
                        errorHtml = '<span class="error-short">' + escapeHtml(j.errorMessage.substring(0, 80)) + '…</span>' +
                                    '<span class="error-full" style="display:none;">' + escapeHtml(j.errorMessage) + '</span> ' +
                                    '<a href="javascript:void(0)" class="error-toggle small">more</a>';
                    } else {
                        errorHtml = escapeHtml(j.errorMessage);
                    }
                }

                html += '<tr class="detail-row ' + stateClass + ' fade-in">';
                html += '<td><a href="' + jobDetailUrl(j.jobId) + '" target="_blank">#' + shortId + '</a></td>';
                html += '<td><a href="' + queueUrl(j.queue) + '" target="_blank" class="text-muted">' + escapeHtml(j.queue) + '</a></td>';
                html += '<td><span class="' + badgeClass + '">' + j.lastState + '</span></td>';
                html += '<td>' + ts + '</td>';
                html += '<td>' + errorHtml + '</td>';
                html += '<td><a href="' + jobDetailUrl(j.jobId) + '" target="_blank" class="btn btn-xs btn-default">History</a></td>';
                html += '</tr>';
            });
            tbody.innerHTML = html;

            // Paginación
            var totalPages = Math.ceil(total / pageSize);
            var startCount = (currentPage - 1) * pageSize + 1;
            var endCount = Math.min(currentPage * pageSize, total);
            var pagHtml = '<div class="clearfix">';
            pagHtml += '<span class="pull-left">Showing ' + startCount + ' - ' + endCount + ' of ' + total + ' jobs</span>';
            pagHtml += '<div class="pull-right">';
            if (currentPage > 1) {
                pagHtml += '<button class="btn btn-default btn-xs" id="prev-page">Previous</button> ';
            }
            if (currentPage < totalPages) {
                pagHtml += '<button class="btn btn-default btn-xs" id="next-page">Next</button>';
            }
            pagHtml += '</div></div>';
            paginationDiv.innerHTML = pagHtml;

            var prevBtn = $('prev-page');
            var nextBtn = $('next-page');
            if (prevBtn) {
                prevBtn.addEventListener('click', function() { currentPage--; renderDetailPage(); });
            }
            if (nextBtn) {
                nextBtn.addEventListener('click', function() { currentPage++; renderDetailPage(); });
            }

            // Toggle error messages
            on('.error-toggle', 'click', function() {
                var cell = this.parentNode;
                var short = cell.querySelector('.error-short');
                var full = cell.querySelector('.error-full');
                if (short.style.display !== 'none') {
                    short.style.display = 'none';
                    full.style.display = 'inline';
                    this.textContent = 'less';
                } else {
                    short.style.display = 'inline';
                    full.style.display = 'none';
                    this.textContent = 'more';
                }
            });
        }

        function updateSortIndicators() {
            document.querySelectorAll('#detail-table th.sortable').forEach(function(th) {
                th.classList.remove('asc', 'desc');
                if (th.getAttribute('data-sort') === currentSort.field) {
                    th.classList.add(currentSort.direction);
                }
            });
        }

        function jobDetailUrl(jobId) {
            return '@Url.To("/jobs/details")' + '/' + jobId;
        }

        function queueUrl(queue) {
            return '@Url.To("/jobs/enqueued")' + '/' + encodeURIComponent(queue);
        }

        function relativeTime(date) {
            var now = new Date();
            var diff = now - date;
            var seconds = Math.floor(diff / 1000);
            if (seconds < 60) return 'just now';
            var minutes = Math.floor(seconds / 60);
            if (minutes < 60) return minutes + 'm ago';
            var hours = Math.floor(minutes / 60);
            if (hours < 24) return hours + 'h ago';
            return date.toLocaleDateString();
        }

        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>