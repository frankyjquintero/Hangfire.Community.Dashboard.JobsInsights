@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True Namespace: Hangfire.Community.Dashboard.ExecutionInsights.Pages *@
@using Hangfire.Dashboard
@using Hangfire.Community.Dashboard.ExecutionInsights
@using Hangfire.Community.Dashboard.ExecutionInsights.Pages
@using Hangfire.Dashboard.Pages
@inherits Hangfire.Dashboard.RazorPage
@{
    Layout = new LayoutPage(JobStatus.Title);
    var summaryApiUrl = $"{Url.To(ExecutionInsightsExtension.RouteBase)}/api/jobtype-summary";
    var detailApiUrl = $"{Url.To(ExecutionInsightsExtension.RouteBase)}/api/jobtype-detail";
    var version = typeof(ExecutionInsightsExtension).Assembly.GetName().Version;
    var versionString = $"v{version.Major}.{version.Minor}.{version.Build}";
}

<style>
    /* Solo lo imprescindible que Bootstrap no cubre: puntos de colores para el resumen */
    .state-dot {
        display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 3px;
        background-color: #ccc; /* idle o desconocido */
    }
    .state-dot.succeeded { background-color: #5cb85c; } /* verde Bootstrap success */
    .state-dot.failed    { background-color: #d9534f; } /* rojo Bootstrap danger */
    .state-dot.processing { background-color: #f0ad4e; }
    /* Modo oscuro: hereda los colores ya definidos en Hangfire; si no, los ajustamos */
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h3>
                @JobStatus.Title
                <small class="text-muted">@versionString</small>
                <button class="btn btn-default btn-sm pull-right" id="refresh-btn">
                    <span class="glyphicon glyphicon-refresh"></span> Refresh
                </button>
            </h3>
            <hr />
        </div>
    </div>

    <!-- VISTA RESUMEN -->
    <div id="summary-view">
        <div class="row">
            <div class="col-md-3">
                <select class="form-control input-sm" id="summary-state-filter">
                    <option value="">All States</option>
                    <option value="Succeeded">Success</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm" id="summary-apply">Apply</button>
            </div>
        </div>
        <div class="row" style="margin-top:15px;">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="summary-table">
                        <thead>
                            <tr>
                                <th>Job Type</th>
                                <th>Last 15 Executions</th>
                                <th>Success</th>
                                <th>Failed</th>
                                <th>Last Execution</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="summary-body">
                            <tr>
                                <td colspan="6" class="text-center text-muted">Loading...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- VISTA DETALLE (Full History) -->
    <div id="detail-view" style="display:none;">
        <div class="row">
            <div class="col-md-12">
                <button class="btn btn-link btn-sm" id="back-to-summary">
                    <span class="glyphicon glyphicon-chevron-left"></span> Back to Summary
                </button>
                <h4>Full History: <span id="detail-jobtype-label"></span></h4>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <select class="form-control input-sm" id="detail-state-filter">
                    <option value="">All States</option>
                    <option value="Succeeded">Success</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm" id="detail-apply">Apply</button>
            </div>
        </div>
        <div class="row" style="margin-top:15px;">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="detail-table">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Queue</th>
                                <th>Last State</th>
                                <th>Last Execution</th>
                                <th>Error</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="detail-body">
                            <tr>
                                <td colspan="6" class="text-center text-muted">Loading...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div id="detail-pagination" class="text-right"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        var summaryApiUrl = '@summaryApiUrl';
        var detailApiUrl = '@detailApiUrl';
        var allDetailJobs = [];
        var currentJobType = null;
        var currentPage = 1;
        var pageSize = 20;

        // Acceso a elementos del DOM con métodos nativos
        function $(id) { return document.getElementById(id); }
        function on(selector, event, handler) {
            var els = document.querySelectorAll(selector);
            for (var i = 0; i < els.length; i++) {
                els[i].addEventListener(event, handler);
            }
        }

        function init() {
            loadSummary();

            $('refresh-btn').addEventListener('click', function() {
                if ($('summary-view').style.display !== 'none') loadSummary();
                else if (currentJobType) loadDetail(currentJobType);
            });
            $('summary-apply').addEventListener('click', loadSummary);
            $('detail-apply').addEventListener('click', function() {
                if (currentJobType) loadDetail(currentJobType);
            });
            $('back-to-summary').addEventListener('click', showSummary);
        }

        function showSummary() {
            $('summary-view').style.display = 'block';
            $('detail-view').style.display = 'none';
        }

        function loadSummary() {
            var state = $('summary-state-filter').value;
            var url = summaryApiUrl + (state ? '?state=' + encodeURIComponent(state) : '');

            $('summary-body').innerHTML = '<tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>';
            fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    renderSummary(data.summaries || []);
                })
                .catch(function(err) {
                    $('summary-body').innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading summary: ' + err.message + '</td></tr>';
                });
        }

        function renderSummary(summaries) {
            var tbody = $('summary-body');
            if (!summaries.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No job types found.</td></tr>';
                return;
            }

            var html = '';
            summaries.forEach(function(s) {
                var dots = '';
                if (s.recentExecutions) {
                    s.recentExecutions.forEach(function(exec) {
                        var cls = exec.state ? exec.state.toLowerCase() : '';
                        var title = exec.state + ' at ' + new Date(exec.timestamp).toLocaleTimeString();
                        dots += '<span class="state-dot ' + cls + '" title="' + title + '"></span>';
                    });
                }

                var lastExec = s.lastExecution ? new Date(s.lastExecution).toLocaleString() : 'N/A';

                html += '<tr>';
                html += '<td>' + escapeHtml(s.jobType) + '</td>';
                html += '<td>' + dots + '</td>';
                html += '<td><span class="badge">' + s.successCount + '</span></td>';
                html += '<td><span class="badge">' + s.failedCount + '</span></td>';
                html += '<td>' + lastExec + '</td>';
                html += '<td><button class="btn btn-xs btn-default view-history" data-jobtype="' + escapeHtml(s.jobType) + '">View Full History</button></td>';
                html += '</tr>';
            });
            tbody.innerHTML = html;

            // Asociar eventos a los nuevos botones
            on('.view-history', 'click', function() {
                var jobType = this.getAttribute('data-jobtype');
                showDetail(jobType);
            });
        }

        function showDetail(jobType) {
            currentJobType = jobType;
            currentPage = 1;
            $('summary-view').style.display = 'none';
            $('detail-view').style.display = 'block';
            $('detail-jobtype-label').textContent = jobType;
            loadDetail(jobType);
        }

        function loadDetail(jobType) {
            var state = $('detail-state-filter').value;
            var url = detailApiUrl + '?jobType=' + encodeURIComponent(jobType);
            if (state) url += '&state=' + encodeURIComponent(state);

            $('detail-body').innerHTML = '<tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>';
            $('detail-pagination').innerHTML = '';

            fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    allDetailJobs = data.jobs || [];
                    // Orden descendente por fecha de última ejecución (más reciente primero)
                    allDetailJobs.sort(function(a, b) {
                        return new Date(b.lastTimestamp) - new Date(a.lastTimestamp);
                    });
                    currentPage = 1;
                    renderDetailPage();
                })
                .catch(function(err) {
                    $('detail-body').innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading detail: ' + err.message + '</td></tr>';
                });
        }

        function renderDetailPage() {
            var total = allDetailJobs.length;
            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;
            var pageJobs = allDetailJobs.slice(start, end);
            renderDetail(pageJobs, total);
        }

        function renderDetail(jobs, total) {
            var tbody = $('detail-body');
            var paginationDiv = $('detail-pagination');
            if (!jobs.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No jobs found for this type.</td></tr>';
                paginationDiv.innerHTML = '';
                return;
            }

            var html = '';
            jobs.forEach(function(j) {
                var shortId = j.jobId ? j.jobId.substring(0, 8) : '';
                var stateClass = j.lastState ? j.lastState.toLowerCase() : '';
                var badgeClass = stateClass === 'succeeded' ? 'label label-success' : 
                                 stateClass === 'failed' ? 'label label-danger' : 'label label-default';
                var ts = j.lastTimestamp ? new Date(j.lastTimestamp).toLocaleString() : '';
                var error = j.errorMessage ? '<span class="text-danger" style="font-size:11px;">' + escapeHtml(j.errorMessage.substring(0, 80)) + '</span>' : '';

                html += '<tr>';
                html += '<td><a href="' + jobDetailUrl(j.jobId) + '" target="_blank">#' + shortId + '</a></td>';
                html += '<td>' + escapeHtml(j.queue) + '</td>';
                html += '<td><span class="' + badgeClass + '">' + j.lastState + '</span></td>';
                html += '<td>' + ts + '</td>';
                html += '<td>' + error + '</td>';
                html += '<td><a href="' + jobDetailUrl(j.jobId) + '" target="_blank" class="btn btn-xs btn-default">History</a></td>';
                html += '</tr>';
            });
            tbody.innerHTML = html;

            // Controles de paginación
            var totalPages = Math.ceil(total / pageSize);
            var startCount = (currentPage - 1) * pageSize + 1;
            var endCount = Math.min(currentPage * pageSize, total);
            var pagHtml = '<div class="clearfix">';
            pagHtml += '<span class="pull-left">Showing ' + startCount + ' - ' + endCount + ' of ' + total + ' jobs</span>';
            pagHtml += '<div class="pull-right">';
            if (currentPage > 1) {
                pagHtml += '<button class="btn btn-default btn-xs" id="prev-page">Previous</button> ';
            }
            if (currentPage < totalPages) {
                pagHtml += '<button class="btn btn-default btn-xs" id="next-page">Next</button>';
            }
            pagHtml += '</div></div>';
            paginationDiv.innerHTML = pagHtml;

            // Asignar eventos a los botones de paginación
            var prevBtn = $('prev-page');
            var nextBtn = $('next-page');
            if (prevBtn) {
                prevBtn.addEventListener('click', function() {
                    currentPage--;
                    renderDetailPage();
                });
            }
            if (nextBtn) {
                nextBtn.addEventListener('click', function() {
                    currentPage++;
                    renderDetailPage();
                });
            }
        }

        function jobDetailUrl(jobId) {
            return '@Url.To("/jobs/details")' + '/' + jobId;
        }

        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        // Iniciar cuando el DOM esté listo
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>